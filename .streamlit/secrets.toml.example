# Copiez ce fichier en .streamlit/secrets.toml (local) ou collez son contenu
# dans « Settings > Secrets » sur Streamlit Community Cloud. NE JAMAIS le versionner.
#
# Hash = SHA-256 de  (salt + mot_de_passe).  Pour le générer :
#   python -c "import hashlib; print(hashlib.sha256(('MON_SEL'+'MonMotDePasse').encode()).hexdigest())"

[auth]
salt = "changez-ce-sel-aleatoire"      # optionnel ; laissez "" pour ne pas saler

[users]
analyste = "REMPLACER_PAR_LE_HASH_SHA256"
admin    = "REMPLACER_PAR_LE_HASH_SHA256"
